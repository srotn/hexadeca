# Git LFS tracking for large checkpoint files
checkpoints/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/*.pth filter=lfs diff=lfs merge=lfs -text
checkpoints/*.tar filter=lfs diff=lfs merge=lfs -text

# Benchmark and analysis outputs (optional, usually regenerated)
benchmark-results/**/*.json filter=lfs diff=lfs merge=lfs -text
analysis/png/*.png filter=lfs diff=lfs merge=lfs -text
