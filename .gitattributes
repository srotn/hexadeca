# Large checkpoint artifacts use Git LFS. Manifests stay ordinary JSON.
checkpoints/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/*.pth filter=lfs diff=lfs merge=lfs -text
checkpoints/*.tar filter=lfs diff=lfs merge=lfs -text
checkpoints/bundles/*/state.pt filter=lfs diff=lfs merge=lfs -text

# Keep POSIX helpers runnable after a Windows checkout.
scripts/*.sh text eol=lf
